# ============================================================
#  .env  —  Environment Variables (Secrets)
#
#  This file stores sensitive values like passwords and keys.
#  NEVER commit this file to GitHub — add it to .gitignore!
#
#  HOW TO USE:
#  1. Copy this file to your backend folder
#  2. Fill in your actual values
#  3. Flask will automatically read these via python-dotenv
# ============================================================

# Your PostgreSQL password (set during PostgreSQL installation)
# Change 'postgres' to whatever password you chose
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/its_db

# Change these to long, random strings in production
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=another-long-random-jwt-secret-key

# Set to False in production
FLASK_DEBUG=True
